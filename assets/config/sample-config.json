{
    "$schema": "./psprofile.schema.json",
    "name": "PSProfile defaults",
    "version": "0.0.0.1",
    "settings": {
        "MaximumHistoryCount": 8192,
        "OneDrivePath": "",
        "PoshTheme": "M365Princess",
        "PoshThemeOverrides": {
            "shell_integration": true
        },
        "ShowWindowTitle": true,
        "ShowSplashScreen": true,
        "SplashCommand": {
            "Windows": "winfetch",
            "MacOS": "screenfetch -E",
            "Linux": "screenfetch -E"
        },
        "SplashCacheHours": 24,
        "ShowElevatedWarning": true,
        "RunUpdateHelpOnElevated": true,
        "ShowPSVersionBanner": true,
        "UpdateCheckIntervalHours": 24,
        "DefaultParameterValues": {
            "Export-Csv:NoTypeInformation": true,
            "ConvertTo-Csv:NoTypeInformation": true,
            "*-PSDrive:PSProvider": "FileSystem",
            "Get-Help:Detailed": true
        },
        "PSReadLine": {
            "PredictionSource": "HistoryAndPlugin",
            "PredictionViewStyle": "ListView",
            "EditMode": "Windows",
            "HistorySearchArrowKeys": true,
            "FilterSecretsFromHistory": true,
            "Colors": {
                "Command": "#87CEEB",
                "Parameter": "#98FB98",
                "Operator": "#FFB6C1",
                "Variable": "#DDA0DD",
                "String": "#FFDAB9",
                "Number": "#B0E0E6",
                "Type": "#F0E68C",
                "Comment": "#D3D3D3",
                "Keyword": "#8367c7",
                "Error": "#FF6347"
            }
        },
        "Zoxide": {
            "Enabled": true,
            "Command": "z"
        },
        "Atuin": {
            "Enabled": false
        },
        "Secrets": {}
    },
    "Aliases": [
        {
            "Name": "edit",
            "Value": "Edit-File",
            "Description": "Edit a file"
        }
    ],
    "Modules": [
        {
            "Name": "TabExpansionPlusPlus",
            "Description": "An enhanced tab expansion module for Windows PowerShell 5.1 - doesn't support PowerShell 7+ (Core), superseded there by native/PSReadLine completion",
            "PSVersionMajorMax": "5",
            "OS": "Windows"
        },
        {
            "Name": "Microsoft.WinGet.CommandNotFound",
            "Description": "PowerToys CommandNotFound module - suggests winget packages for unrecognized commands",
            "PSVersionMajor": "5",
            "OS": "Windows"
        },
        {
            "Name": "PSFzf",
            "Description": "fzf key bindings: Ctrl+R history, Ctrl+T files, Alt+C directories. Needs the fzf package",
            "PSVersionMajor": "5",
            "OS": "All",
            "RequiresCommand": "fzf"
        },
        {
            "Name": "CompletionPredictor",
            "Description": "Adds tab-completion results to PSReadLine's inline/list predictions (PredictionSource HistoryAndPlugin). Needs PowerShell 7.2+",
            "PSVersionMajor": "7",
            "OS": "All"
        }
    ],
    "Packages": [
        {
            "Name": "speedtest",
            "Id": "ookla.speedtest.cli",
            "Source": "winget"
        },
        {
            "Name": "speedtest",
            "Id": "speedtest-cli",
            "Source": "brew"
        },
        {
            "Name": "speedtest",
            "Id": "speedtest-cli",
            "Source": "apt"
        },
        {
            "Name": "speedtest",
            "Id": "speedtest-cli",
            "Source": "yum"
        },
        {
            "Name": "speedtest",
            "Id": "speedtest-cli",
            "Source": "pacman"
        },
        {
            "Name": "fzf",
            "Id": "junegunn.fzf",
            "Source": "winget"
        },
        {
            "Name": "fzf",
            "Id": "fzf",
            "Source": "brew"
        },
        {
            "Name": "fzf",
            "Id": "fzf",
            "Source": "apt"
        },
        {
            "Name": "fzf",
            "Id": "fzf",
            "Source": "yum"
        },
        {
            "Name": "fzf",
            "Id": "fzf",
            "Source": "pacman"
        },
        {
            "Name": "zoxide",
            "Id": "ajeetdsouza.zoxide",
            "Source": "winget"
        },
        {
            "Name": "zoxide",
            "Id": "zoxide",
            "Source": "brew"
        },
        {
            "Name": "zoxide",
            "Id": "zoxide",
            "Source": "apt"
        },
        {
            "Name": "zoxide",
            "Id": "zoxide",
            "Source": "yum"
        },
        {
            "Name": "zoxide",
            "Id": "zoxide",
            "Source": "pacman"
        }
    ],
    "NativeCompletions": [
        {
            "Name": "docker",
            "GenerateCommand": "docker completion powershell"
        },
        {
            "Name": "kubectl",
            "GenerateCommand": "kubectl completion powershell"
        },
        {
            "Name": "gh",
            "GenerateCommand": "gh completion -s powershell"
        },
        {
            "Name": "helm",
            "GenerateCommand": "helm completion powershell"
        }
    ]
}
